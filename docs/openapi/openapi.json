{
  "openapi": "3.0.3",
  "info": {
    "title": "Scilab API",
    "version": "1.2.0",
    "description": "API documentation for the Scilab backend."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "API availability checks."
    },
    {
      "name": "Auth",
      "description": "JWT-backed authentication sessions."
    },
    {
      "name": "Users",
      "description": "User profile and admin user management."
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a student account",
        "operationId": "register",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration succeeded and no authenticated session was issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponseEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Sign in with credentials",
        "operationId": "login",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sign-in succeeded and an authenticated session was issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairResponseEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access and refresh tokens",
        "operationId": "refreshTokens",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refresh succeeded and a new token pair was issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairResponseEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoke the current authenticated session",
        "operationId": "logout",
        "tags": ["Auth"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current session was revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponseEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Return the authenticated user",
        "operationId": "getCurrentUser",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current authenticated user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "List users",
        "operationId": "listUsers",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved for admin management.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponseEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "summary": "Create a user",
        "operationId": "createUser",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserMutationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Get a user by id",
        "operationId": "getUser",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "responses": {
          "200": {
            "description": "User was retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "summary": "Update a user",
        "operationId": "updateUser",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User was updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "delete": {
        "summary": "Delete a user",
        "operationId": "deleteUser",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "responses": {
          "200": {
            "description": "User was deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponseEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/users/{id}/role": {
      "patch": {
        "summary": "Update a user role",
        "operationId": "updateUserRole",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRoleUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User role was updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "UserId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request body is missing required fields or is malformed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseEnvelope"
            },
            "examples": {
              "missingCredentials": {
                "value": {
                  "success": false,
                  "message": "Email and password are required",
                  "data": {}
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed or the session is not valid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseEnvelope"
            },
            "examples": {
              "authenticationFailed": {
                "value": {
                  "success": false,
                  "message": "Authentication failed",
                  "data": {}
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Request is not allowed for the current account or reserved identity.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseEnvelope"
            },
            "examples": {
              "inactiveAccount": {
                "value": {
                  "success": false,
                  "message": "Account is not allowed to sign in",
                  "data": {}
                }
              },
              "reservedAdminEmail": {
                "value": {
                  "success": false,
                  "message": "Admin account cannot be registered",
                  "data": {}
                }
              }
            }
          }
        }
      },
      "Conflict": {
        "description": "A unique account value already exists.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseEnvelope"
            },
            "examples": {
              "emailAlreadyRegistered": {
                "value": {
                  "success": false,
                  "message": "Email is already registered",
                  "data": {}
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseEnvelope"
            },
            "examples": {
              "userMissing": {
                "value": {
                  "success": false,
                  "message": "User was not found",
                  "data": {}
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ApiResponseBase": {
        "type": "object",
        "required": ["success", "message", "data"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "format": "password",
            "example": "Password123!"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "firstName",
          "lastName",
          "dateOfBirth",
          "gender"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "example": "student@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1024,
            "format": "password",
            "example": "12345678"
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "example": "Student"
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "example": "User"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "2000-01-02"
          },
          "gender": {
            "type": "string",
            "enum": ["MALE", "FEMALE", "OTHER"],
            "example": "FEMALE"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token issued by login or refresh."
          }
        }
      },
      "UserMutationRequest": {
        "type": "object",
        "required": ["email", "password", "type", "status", "role"],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "example": "researcher@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1024,
            "format": "password",
            "example": "Password123!"
          },
          "type": {
            "type": "string",
            "enum": ["EMAIL", "GOOGLE"],
            "example": "EMAIL"
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "INACTIVE", "BANNED"],
            "example": "ACTIVE"
          },
          "role": {
            "type": "string",
            "enum": ["STUDENT", "RESEARCHER", "ADMIN"],
            "example": "RESEARCHER"
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 2048
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "nullable": true,
            "enum": ["MALE", "FEMALE", "OTHER"]
          }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "example": "researcher@example.com"
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "imgUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 2048
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "nullable": true,
            "enum": ["MALE", "FEMALE", "OTHER"]
          }
        }
      },
      "UserRoleUpdateRequest": {
        "type": "object",
        "required": ["role"],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": ["STUDENT", "RESEARCHER"],
            "example": "RESEARCHER"
          }
        }
      },
      "HealthResponseEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "required": ["success", "message", "data"],
            "properties": {
              "success": {
                "type": "boolean",
                "enum": [true]
              },
              "message": {
                "type": "string",
                "example": "OK"
              },
              "data": {
                "type": "string",
                "example": "Hello World!"
              }
            }
          }
        ]
      },
      "TokenPairResponseEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "required": ["success", "message", "data"],
            "properties": {
              "success": {
                "type": "boolean",
                "enum": [true]
              },
              "message": {
                "type": "string",
                "example": "Authentication successful"
              },
              "data": {
                "$ref": "#/components/schemas/TokenPairData"
              }
            }
          }
        ]
      },
      "RegistrationResponseEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "required": ["success", "message", "data"],
            "properties": {
              "success": {
                "type": "boolean",
                "enum": [true]
              },
              "message": {
                "type": "string",
                "example": "Registration successful"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "example": {}
              }
            }
          }
        ]
      },
      "UserResponseEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "required": ["success", "message", "data"],
            "properties": {
              "success": {
                "type": "boolean",
                "enum": [true]
              },
              "message": {
                "type": "string",
              "example": "Current user retrieved"
            },
            "data": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        ]
      },
      "UserListResponseEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "required": ["success", "message", "data"],
            "properties": {
              "success": {
                "type": "boolean",
                "enum": [true]
              },
              "message": {
                "type": "string",
                "example": "Users retrieved"
              },
              "data": {
                "type": "object",
                "required": ["users"],
                "additionalProperties": false,
                "properties": {
                  "users": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "EmptyResponseEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "required": ["success", "message", "data"],
            "properties": {
              "success": {
                "type": "boolean",
                "enum": [true]
              },
              "message": {
                "type": "string",
                "example": "Logout successful"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "example": {}
              }
            }
          }
        ]
      },
      "ErrorResponseEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "required": ["success", "message", "data"],
            "properties": {
              "success": {
                "type": "boolean",
                "enum": [false]
              },
              "message": {
                "type": "string",
                "example": "Authentication failed"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "example": {}
              }
            }
          }
        ]
      },
      "TokenPairData": {
        "type": "object",
        "required": ["accessToken", "refreshToken"],
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token for bearer authentication. Expires 30 minutes after issue."
          },
          "refreshToken": {
            "type": "string",
            "description": "Refresh token for obtaining a new token pair. Expires 30 days after issue."
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "type",
          "status",
          "role",
          "firstName",
          "lastName",
          "imageUrl",
          "dateOfBirth",
          "gender",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "type": {
            "type": "string",
            "enum": ["EMAIL", "GOOGLE"]
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "INACTIVE", "BANNED"]
          },
          "role": {
            "type": "string",
            "enum": ["STUDENT", "RESEARCHER", "ADMIN"]
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "nullable": true,
            "enum": ["MALE", "FEMALE", "OTHER"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
