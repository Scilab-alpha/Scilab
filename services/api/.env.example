# Environment variables for the API service
DATABASE_URL=postgresql://postgres:123@localhost:5433/scilab?schema=public
PORT=3000

# Neo4j graph database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="12345678"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60000
NEO4J_CONNECTION_TIMEOUT=30000
NEO4J_MAX_TRANSACTION_RETRY_TIME=30000

# JWT configuration
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=scilab-api

# Default admin account created on application startup
ADMIN_EMAIL=Admin@admin.com
ADMIN_PASSWORD=12345678
