# Environment variables for the API service
DATABASE_URL=postgresql://postgres:123@localhost:5433/scilab?schema=public
PORT=3000
CLIENT_URL=http://localhost:3000

# Neo4j graph database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="12345678"
NEO4J_DATABASE="neo4j"
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60000
NEO4J_CONNECTION_TIMEOUT=30000
NEO4J_MAX_TRANSACTION_RETRY_TIME=30000

# JWT configuration
JWT_ACCESS_SECRET=scilab@123
JWT_ISSUER=scilab-api

# Default admin account created on application startup
ADMIN_EMAIL=Admin@admin.com
ADMIN_PASSWORD=12345678

# OpenAlex API integration
OPENALEX_API_KEY=replace-with-openalex-api-key
OPENALEX_API_BASE_URL=https://api.openalex.org
OPENALEX_JOURNAL_BACKFILL_FROM_YEAR=2020
OPENALEX_JOURNAL_DAILY_PAGE_BUDGET=1000
OPENALEX_JOURNAL_MAX_PAGES_PER_PASS=10
OPENALEX_SOURCE_BATCH_SIZE=100
OPENALEX_JOURNAL_BATCH_SIZE=100
OPENALEX_OUTGOING_REFERENCE_BATCH_SIZE=100

# SCImago datasets (resolved from services/api)
SCIMAGO_RAW_DIR=../../docs/scimagojr/raw
SCIMAGO_DATASET_DIR=../../docs/scimagojr/normalized

# BullMQ / Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=scilab@123
REDIS_DB=0
BULLMQ_PREFIX=scilab
ACADEMIC_WORKER_MODE=false
