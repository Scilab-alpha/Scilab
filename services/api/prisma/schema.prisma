generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  EMAIL
  GOOGLE

  @@map("auth_provider")
}

enum StatusAccount {
  ACTIVE
  INACTIVE
  BANNED

  @@map("status_account")
}

enum RoleAccount {
  STUDENT
  LECTURER
  RESEARCHER
  ADMIN

  @@map("role_account")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum FollowObjectType {
  JOURNAL
  KEYWORD
  TOPIC

  @@map("follow_object_type")
}

enum NotifyMode {
  IN_APP
  DAILY_EMAIL
  WEEKLY_EMAIL
  OFF

  @@map("notify_mode")
}

enum NotificationObjectType {
  ARTICLE
  JOURNAL
  KEYWORD
  TOPIC

  @@map("notification_object_type")
}

enum PushProvider {
  EXPO
  FCM

  @@map("push_provider")
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN

  @@map("push_platform")
}

enum SyncFrequency {
  DAILY
  WEEKLY

  @@map("sync_frequency")
}

enum SyncSource {
  OPENALEX
  SEMANTIC_SCHOLAR
  CROSSREF
  SCIMAGO
  NEO4J
  SYSTEM

  @@map("sync_source")
}

enum SyncJobType {
  SCHEDULED_SYNC
  MANUAL_SYNC
  ORPHAN_CLEANUP
  TREND_AGGREGATION
  ALERT_DISPATCH
  SCIMAGO_RELOAD
  ARTICLE_SYNC
  REFERENCE_HYDRATION
  INCOMING_CITATION_CRAWL
  CITATION_COUNT_REFRESH

  @@map("sync_job_type")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL

  @@map("sync_status")
}

enum RankingMetricType {
  QUARTILE
  RANK
  SCORE
  PERCENTILE

  @@map("ranking_metric_type")
}

enum RankingSource {
  SCIMAGO
  SCOPUS
  WOS
  DOAJ
  OTHER

  @@map("ranking_source")
}

model User {
  id            String           @id @default(uuid()) @map("user_id") @db.Uuid
  email         String           @unique @db.VarChar(255)
  password      String           @map("password_hash") @db.VarChar(255)
  type          AuthProvider
  status        StatusAccount
  role          RoleAccount
  lastName      String?          @map("last_name") @db.VarChar(255)
  firstName     String?          @map("first_name") @db.VarChar(255)
  imageUrl      String?          @map("url_image") @db.VarChar(2048)
  dateOfBirth   DateTime?        @map("date_of_birth") @db.Date
  gender        Gender?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)
  authSessions  AuthSession[]
  bookmarks     UserBookmark[]
  follows       UserFollow[]
  notifications Notification[]
  pushDevices   UserPushDevice[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("user_account")
}

model AuthSession {
  id                    String    @id @default(uuid()) @map("auth_session_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accessTokenIdHash     String    @unique @map("access_token_id_hash") @db.VarChar(128)
  refreshTokenHash      String    @unique @map("refresh_token_hash") @db.VarChar(128)
  issuedAt              DateTime  @map("issued_at") @db.Timestamp(6)
  accessTokenExpiresAt  DateTime  @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime  @map("refresh_token_expires_at") @db.Timestamp(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamp(6)
  lastUsedAt            DateTime? @map("last_used_at") @db.Timestamp(6)
  rotatedAt             DateTime? @map("rotated_at") @db.Timestamp(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessTokenExpiresAt])
  @@index([refreshTokenExpiresAt])
  @@map("auth_session")
}

model UserBookmark {
  id        String   @id @default(uuid()) @map("user_bookmark_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt])
  @@index([articleId])
  @@map("user_bookmark")
}

model UserFollow {
  id         String           @id @default(uuid()) @map("user_follow_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  objectType FollowObjectType @map("object_type")
  objectId   String           @map("object_id") @db.Uuid
  notifyMode NotifyMode       @default(IN_APP) @map("notify_mode")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, objectType, objectId])
  @@index([userId, createdAt])
  @@index([objectType, objectId])
  @@map("user_follow")
}

model Notification {
  id                String                  @id @default(uuid()) @map("notification_id") @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  title             String                  @db.VarChar(255)
  message           String                  @db.Text
  relatedObjectType NotificationObjectType? @map("related_object_type")
  relatedObjectId   String?                 @map("related_object_id") @db.Uuid
  isRead            Boolean                 @default(false) @map("is_read")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  readAt            DateTime?               @map("read_at") @db.Timestamp(6)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, relatedObjectType, relatedObjectId])
  @@index([userId, isRead, createdAt])
  @@index([relatedObjectType, relatedObjectId])
  @@map("notification")
}

model UserPushDevice {
  id               String       @id @default(uuid()) @map("push_device_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  provider         PushProvider
  token            String       @db.VarChar(2048)
  platform         PushPlatform @default(UNKNOWN)
  clientDeviceId   String?      @map("client_device_id") @db.VarChar(255)
  isActive         Boolean      @default(true) @map("is_active")
  lastRegisteredAt DateTime     @default(now()) @map("last_registered_at") @db.Timestamp(6)
  lastUsedAt       DateTime?    @map("last_used_at") @db.Timestamp(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, token])
  @@index([userId, isActive])
  @@index([provider, isActive])
  @@map("user_push_device")
}

model SystemConfig {
  id              String        @id @default(uuid()) @map("config_id") @db.Uuid
  apiName         String        @unique @map("api_name") @db.VarChar(100)
  apiEndpoint     String        @map("api_endpoint") @db.VarChar(2048)
  apiKeyEncrypted String?       @map("api_key_encrypted") @db.Text
  syncFrequency   SyncFrequency @map("sync_frequency")
  isActive        Boolean       @default(true) @map("is_active")
  lastTestedAt    DateTime?     @map("last_tested_at") @db.Timestamp(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  syncLogs        SyncLog[]

  @@index([isActive])
  @@map("system_config")
}

model SyncLog {
  id              String       @id @default(uuid()) @map("sync_log_id") @db.Uuid
  configId        String       @map("config_id") @db.Uuid
  source          SyncSource
  jobType         SyncJobType  @map("job_type")
  startedAt       DateTime     @map("started_at") @db.Timestamp(6)
  finishedAt      DateTime?    @map("finished_at") @db.Timestamp(6)
  totalFetched    Int          @default(0) @map("total_fetched")
  totalInserted   Int          @default(0) @map("total_inserted")
  totalUpdated    Int          @default(0) @map("total_updated")
  totalErrors     Int          @default(0) @map("total_errors")
  orphanFound     Int          @default(0) @map("orphan_found")
  orphanProcessed Int          @default(0) @map("orphan_processed")
  status          SyncStatus
  errorDetail     String?      @map("error_detail") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  config          SystemConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@index([source, startedAt])
  @@index([configId, startedAt])
  @@index([jobType, startedAt])
  @@index([status, startedAt])
  @@map("sync_log")
}

model AcademicSyncCheckpoint {
  key                     String    @id @map("checkpoint_key") @db.VarChar(100)
  cursor                  String?   @db.Text
  initialBackfillComplete Boolean   @default(false) @map("initial_backfill_complete")
  lastSuccessfulAt        DateTime? @map("last_successful_at") @db.Timestamp(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("academic_sync_checkpoint")
}

model SubjectArea {
  id                String            @id @default(uuid()) @map("subject_area_id") @db.Uuid
  displayName       String            @unique @map("display_name") @db.VarChar(255)
  description       String?           @db.VarChar(1000)
  subjectCategories SubjectCategory[]

  @@map("subject_area")
}

model SubjectCategory {
  id              String           @id @default(uuid()) @map("subject_category_id") @db.Uuid
  subjectAreaId   String?          @map("subject_area_id") @db.Uuid
  displayName     String           @unique @map("display_name") @db.VarChar(255)
  description     String?          @db.VarChar(1000)
  subjectArea     SubjectArea?     @relation(fields: [subjectAreaId], references: [id], onDelete: SetNull)
  journalRankings JournalRanking[]

  @@index([subjectAreaId])
  @@map("subject_category")
}

model RankingMetric {
  id          String            @id @default(uuid()) @map("metric_id") @db.Uuid
  code        String            @unique @db.VarChar(100)
  displayName String?           @map("display_name") @db.VarChar(255)
  metricType  RankingMetricType @map("metric_type")
  description String?           @db.VarChar(1000)
  rankings    JournalRanking[]

  @@map("ranking_metric")
}

model JournalRanking {
  id                String           @id @default(uuid()) @map("journal_ranking_id") @db.Uuid
  journalId         String           @map("journal_id") @db.VarChar(255)
  subjectCategoryId String?          @map("subject_category_id") @db.Uuid
  metricId          String           @map("metric_id") @db.Uuid
  source            RankingSource
  year              Int
  scopeKey          String           @map("scope_key") @db.VarChar(64)
  valueText         String?          @map("value_txt") @db.VarChar(255)
  valueInt          Int?             @map("value_int")
  valueFloat        Float?           @map("value_float")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  subjectCategory   SubjectCategory? @relation(fields: [subjectCategoryId], references: [id], onDelete: SetNull)
  metric            RankingMetric    @relation(fields: [metricId], references: [id], onDelete: Restrict)

  @@unique([journalId, scopeKey, source, metricId, year])
  @@index([journalId, year])
  @@index([metricId])
  @@index([subjectCategoryId])
  @@index([source, year])
  @@map("journal_ranking")
}
