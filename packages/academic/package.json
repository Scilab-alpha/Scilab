{
  "name": "@repo/academic",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "default": "./dist/adapters.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "lint": "tsc --noEmit -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@prisma/client": "^7.8.0",
    "@repo/academic-queue": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/neo4j": "workspace:*",
    "axios": "^1.18.1",
    "bullmq": "^5.80.2",
    "neo4j-driver": "^6.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.2"
  }
}
