generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  EMAIL
  GOOGLE

  @@map("auth_provider")
}

enum StatusAccount {
  ACTIVE
  INACTIVE
  BANNED

  @@map("status_account")
}

enum RoleAccount {
  STUDENT
  LECTURER
  RESEARCHER
  ADMIN

  @@map("role_account")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum FollowObjectType {
  AUTHOR
  JOURNAL
  KEYWORD
  TOPIC

  @@map("follow_object_type")
}

enum NotifyMode {
  IN_APP
  DAILY_EMAIL
  WEEKLY_EMAIL
  OFF

  @@map("notify_mode")
}

enum NotificationObjectType {
  ARTICLE
  JOURNAL
  KEYWORD
  TOPIC

  @@map("notification_object_type")
}

enum PushProvider {
  EXPO
  FCM

  @@map("push_provider")
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN

  @@map("push_platform")
}

enum SyncFrequency {
  DAILY
  WEEKLY

  @@map("sync_frequency")
}

enum SyncSource {
  OPENALEX
  SEMANTIC_SCHOLAR
  CROSSREF
  SCIMAGO
  NEO4J
  SYSTEM

  @@map("sync_source")
}

enum SyncJobType {
  SCHEDULED_SYNC
  MANUAL_SYNC
  ORPHAN_CLEANUP
  TREND_AGGREGATION
  ALERT_DISPATCH
  SCIMAGO_RELOAD
  REFERENCE_HYDRATION
  INCOMING_CITATION_CRAWL
  CITATION_COUNT_REFRESH
  JOURNAL_SOURCE_SYNC
  JOURNAL_ARTICLE_SYNC
  RELATED_WORK_SYNC
  RELATED_WORK_HYDRATION
  OUTGOING_REFERENCE_CRAWL
  SEMANTIC_SCHOLAR_JOURNAL_SUPPLEMENT

  @@map("sync_job_type")
}

enum AcademicJournalMatchStatus {
  PENDING
  MATCHED
  UNMATCHED
  CONFLICT

  @@map("academic_journal_match_status")
}

enum AcademicJournalSyncMode {
  BACKFILL
  INCREMENTAL

  @@map("academic_journal_sync_mode")
}

enum SemanticScholarSupplementStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_SHORTFALL
  FAILED

  @@map("semantic_scholar_supplement_status")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
  CANCELLED

  @@map("sync_status")
}

enum AcademicJobRunTrigger {
  CRON
  MANUAL
  RETRY

  @@map("academic_job_run_trigger")
}

enum AcademicJobRunStatus {
  WAITING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED

  @@map("academic_job_run_status")
}

enum AcademicJobAuditAction {
  PAUSE
  RESUME
  TRIGGER
  CANCEL
  RETRY

  @@map("academic_job_audit_action")
}

enum AcademicJobAuditOutcome {
  PENDING
  SUCCESS
  REJECTED
  FAILED

  @@map("academic_job_audit_outcome")
}

enum RankingMetricType {
  QUARTILE
  RANK
  SCORE
  PERCENTILE

  @@map("ranking_metric_type")
}

enum RankingSource {
  SCIMAGO
  SCOPUS
  WOS
  DOAJ
  OTHER

  @@map("ranking_source")
}

model User {
  id            String           @id @default(uuid()) @map("user_id") @db.Uuid
  email         String           @unique @db.VarChar(255)
  password      String           @map("password_hash") @db.VarChar(255)
  type          AuthProvider
  status        StatusAccount
  role          RoleAccount
  lastName      String?          @map("last_name") @db.VarChar(255)
  firstName     String?          @map("first_name") @db.VarChar(255)
  imageUrl      String?          @map("url_image") @db.VarChar(2048)
  dateOfBirth   DateTime?        @map("date_of_birth") @db.Date
  gender        Gender?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)
  authSessions  AuthSession[]
  bookmarks     UserBookmark[]
  follows       UserFollow[]
  notifications Notification[]
  pushDevices   UserPushDevice[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("user_account")
}

model AuthSession {
  id                    String    @id @default(uuid()) @map("auth_session_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accessTokenIdHash     String    @unique @map("access_token_id_hash") @db.VarChar(128)
  refreshTokenHash      String    @unique @map("refresh_token_hash") @db.VarChar(128)
  issuedAt              DateTime  @map("issued_at") @db.Timestamp(6)
  accessTokenExpiresAt  DateTime  @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime  @map("refresh_token_expires_at") @db.Timestamp(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamp(6)
  lastUsedAt            DateTime? @map("last_used_at") @db.Timestamp(6)
  rotatedAt             DateTime? @map("rotated_at") @db.Timestamp(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessTokenExpiresAt])
  @@index([refreshTokenExpiresAt])
  @@map("auth_session")
}

model UserBookmark {
  id        String   @id @default(uuid()) @map("user_bookmark_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt])
  @@index([articleId])
  @@map("user_bookmark")
}

model UserFollow {
  id         String           @id @default(uuid()) @map("user_follow_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  objectType FollowObjectType @map("object_type")
  objectId   String           @map("object_id") @db.VarChar(128)
  notifyMode NotifyMode       @default(IN_APP) @map("notify_mode")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, objectType, objectId])
  @@index([userId, createdAt])
  @@index([objectType, objectId])
  @@map("user_follow")
}

model Notification {
  id                String                  @id @default(uuid()) @map("notification_id") @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  title             String                  @db.VarChar(255)
  message           String                  @db.Text
  relatedObjectType NotificationObjectType? @map("related_object_type")
  relatedObjectId   String?                 @map("related_object_id") @db.Uuid
  isRead            Boolean                 @default(false) @map("is_read")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  readAt            DateTime?               @map("read_at") @db.Timestamp(6)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, relatedObjectType, relatedObjectId])
  @@index([userId, isRead, createdAt])
  @@index([relatedObjectType, relatedObjectId])
  @@map("notification")
}

model UserPushDevice {
  id               String       @id @default(uuid()) @map("push_device_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  provider         PushProvider
  token            String       @db.VarChar(2048)
  platform         PushPlatform @default(UNKNOWN)
  clientDeviceId   String?      @map("client_device_id") @db.VarChar(255)
  isActive         Boolean      @default(true) @map("is_active")
  lastRegisteredAt DateTime     @default(now()) @map("last_registered_at") @db.Timestamp(6)
  lastUsedAt       DateTime?    @map("last_used_at") @db.Timestamp(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, token])
  @@index([userId, isActive])
  @@index([provider, isActive])
  @@map("user_push_device")
}

model SystemConfig {
  id              String        @id @default(uuid()) @map("config_id") @db.Uuid
  apiName         String        @unique @map("api_name") @db.VarChar(100)
  apiEndpoint     String        @map("api_endpoint") @db.VarChar(2048)
  apiKeyEncrypted String?       @map("api_key_encrypted") @db.Text
  syncFrequency   SyncFrequency @map("sync_frequency")
  isActive        Boolean       @default(true) @map("is_active")
  lastTestedAt    DateTime?     @map("last_tested_at") @db.Timestamp(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  syncLogs        SyncLog[]

  @@index([isActive])
  @@map("system_config")
}

model SyncLog {
  id              String       @id @default(uuid()) @map("sync_log_id") @db.Uuid
  configId        String       @map("config_id") @db.Uuid
  source          SyncSource
  jobType         SyncJobType  @map("job_type")
  startedAt       DateTime     @map("started_at") @db.Timestamp(6)
  finishedAt      DateTime?    @map("finished_at") @db.Timestamp(6)
  totalFetched    Int          @default(0) @map("total_fetched")
  totalInserted   Int          @default(0) @map("total_inserted")
  totalUpdated    Int          @default(0) @map("total_updated")
  totalErrors     Int          @default(0) @map("total_errors")
  orphanFound     Int          @default(0) @map("orphan_found")
  orphanProcessed Int          @default(0) @map("orphan_processed")
  status          SyncStatus
  errorDetail     String?      @map("error_detail") @db.Text
  jobRunId        String?      @map("job_run_id") @db.Uuid
  successCount    Int          @default(0) @map("success_count")
  failureCount    Int          @default(0) @map("failure_count")
  metrics         Json?        @map("metrics")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  config          SystemConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  jobRun          AcademicJobRun? @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  @@index([source, startedAt])
  @@index([configId, startedAt])
  @@index([jobType, startedAt])
  @@index([status, startedAt])
  @@index([jobRunId])
  @@map("sync_log")
}

model AcademicJobControl {
  jobId           String    @id @map("job_id") @db.VarChar(100)
  isPaused        Boolean   @default(false) @map("is_paused")
  pausedAt        DateTime? @map("paused_at") @db.Timestamp(6)
  pausedByUserId  String?   @map("paused_by_user_id") @db.Uuid
  pausedByEmail   String?   @map("paused_by_email") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("academic_job_control")
}

model AcademicJobRun {
  id                    String                @id @default(uuid()) @map("job_run_id") @db.Uuid
  jobId                 String                @map("job_id") @db.VarChar(100)
  bullJobId             String?               @unique @map("bull_job_id") @db.VarChar(255)
  trigger               AcademicJobRunTrigger
  status                AcademicJobRunStatus  @default(WAITING)
  scheduledAt           DateTime              @map("scheduled_at") @db.Timestamp(6)
  queuedAt              DateTime              @default(now()) @map("queued_at") @db.Timestamp(6)
  startedAt             DateTime?             @map("started_at") @db.Timestamp(6)
  finishedAt            DateTime?             @map("finished_at") @db.Timestamp(6)
  progressCurrent       Int                   @default(0) @map("progress_current")
  progressTotal         Int?                  @map("progress_total")
  progressMessage       String?               @map("progress_message") @db.VarChar(500)
  attemptCount          Int                   @default(0) @map("attempt_count")
  errorDetail           String?               @map("error_detail") @db.Text
  cancellationRequestedAt DateTime?           @map("cancellation_requested_at") @db.Timestamp(6)
  retriedFromRunId      String?               @map("retried_from_run_id") @db.Uuid
  createdByAdminId      String?               @map("created_by_admin_id") @db.Uuid
  createdByAdminEmail   String?               @map("created_by_admin_email") @db.VarChar(255)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)
  syncLogs              SyncLog[]

  @@index([jobId, status, queuedAt])
  @@index([jobId, startedAt])
  @@index([retriedFromRunId])
  @@map("academic_job_run")
}

model AcademicJobAudit {
  id              String                  @id @default(uuid()) @map("job_audit_id") @db.Uuid
  jobId           String                  @map("job_id") @db.VarChar(100)
  runId           String?                 @map("job_run_id") @db.Uuid
  adminUserId     String                  @map("admin_user_id") @db.Uuid
  adminEmail      String                  @map("admin_email") @db.VarChar(255)
  action          AcademicJobAuditAction
  outcome         AcademicJobAuditOutcome @default(PENDING)
  reason          String?                 @db.VarChar(500)
  errorDetail     String?                 @map("error_detail") @db.Text
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  completedAt     DateTime?               @map("completed_at") @db.Timestamp(6)

  @@index([jobId, createdAt])
  @@index([adminUserId, createdAt])
  @@map("academic_job_audit")
}

model AcademicJournalSyncState {
  scimagoSourceId         String                     @id @map("scimago_source_id") @db.VarChar(64)
  catalogYear             Int                        @map("catalog_year")
  openAlexJournalId       String?                    @unique @map("openalex_journal_id") @db.VarChar(255)
  matchStatus             AcademicJournalMatchStatus @default(PENDING) @map("match_status")
  matchedIssn             String?                    @map("matched_issn") @db.VarChar(32)
  candidateJournalIds     String[]                   @default([]) @map("candidate_journal_ids")
  syncMode                AcademicJournalSyncMode    @default(BACKFILL) @map("sync_mode")
  cursor                  String?                    @db.Text
  filterSignature         String?                    @map("filter_signature") @db.VarChar(128)
  incrementalWindowFrom   DateTime?                  @map("incremental_window_from") @db.Timestamp(6)
  initialBackfillComplete Boolean                    @default(false) @map("initial_backfill_complete")
  lastResolvedAt          DateTime?                  @map("last_resolved_at") @db.Timestamp(6)
  lastSuccessfulAt        DateTime?                  @map("last_successful_at") @db.Timestamp(6)
  errorDetail             String?                    @map("error_detail") @db.Text
  semanticScholarStatus   SemanticScholarSupplementStatus @default(PENDING) @map("semantic_scholar_status")
  semanticScholarNewToken String?                    @map("semantic_scholar_new_token") @db.Text
  semanticScholarNewAccepted Int                      @default(0) @map("semantic_scholar_new_accepted")
  semanticScholarRelatedAccepted Int                  @default(0) @map("semantic_scholar_related_accepted")
  semanticScholarProcessedSeedIds String[]            @default([]) @map("semantic_scholar_processed_seed_ids")
  semanticScholarStartedAt DateTime?                  @map("semantic_scholar_started_at") @db.Timestamp(6)
  semanticScholarCompletedAt DateTime?                @map("semantic_scholar_completed_at") @db.Timestamp(6)
  semanticScholarErrorDetail String?                  @map("semantic_scholar_error_detail") @db.Text
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([matchStatus, catalogYear])
  @@index([initialBackfillComplete, lastSuccessfulAt])
  @@index([semanticScholarStatus, catalogYear])
  @@map("academic_journal_sync_state")
}

model SubjectArea {
  id                String            @id @default(uuid()) @map("subject_area_id") @db.Uuid
  displayName       String            @unique @map("display_name") @db.VarChar(255)
  description       String?           @db.VarChar(1000)
  subjectCategories SubjectCategory[]

  @@map("subject_area")
}

model SubjectCategory {
  id              String           @id @default(uuid()) @map("subject_category_id") @db.Uuid
  subjectAreaId   String?          @map("subject_area_id") @db.Uuid
  displayName     String           @unique @map("display_name") @db.VarChar(255)
  description     String?          @db.VarChar(1000)
  subjectArea     SubjectArea?     @relation(fields: [subjectAreaId], references: [id], onDelete: SetNull)
  journalRankings JournalRanking[]

  @@index([subjectAreaId])
  @@map("subject_category")
}

model RankingMetric {
  id          String            @id @default(uuid()) @map("metric_id") @db.Uuid
  code        String            @unique @db.VarChar(100)
  displayName String?           @map("display_name") @db.VarChar(255)
  metricType  RankingMetricType @map("metric_type")
  description String?           @db.VarChar(1000)
  rankings    JournalRanking[]

  @@map("ranking_metric")
}

model JournalRanking {
  id                String           @id @default(uuid()) @map("journal_ranking_id") @db.Uuid
  journalId         String           @map("journal_id") @db.VarChar(255)
  subjectCategoryId String?          @map("subject_category_id") @db.Uuid
  metricId          String           @map("metric_id") @db.Uuid
  source            RankingSource
  year              Int
  scopeKey          String           @map("scope_key") @db.VarChar(64)
  valueText         String?          @map("value_txt") @db.VarChar(255)
  valueInt          Int?             @map("value_int")
  valueFloat        Float?           @map("value_float")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  subjectCategory   SubjectCategory? @relation(fields: [subjectCategoryId], references: [id], onDelete: SetNull)
  metric            RankingMetric    @relation(fields: [metricId], references: [id], onDelete: Restrict)

  @@unique([journalId, scopeKey, source, metricId, year])
  @@index([journalId, year])
  @@index([metricId])
  @@index([subjectCategoryId])
  @@index([source, year])
  @@map("journal_ranking")
}
