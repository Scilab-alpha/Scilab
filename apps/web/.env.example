# Copy to .env.local (gitignored).
#
# Prefer same-origin proxy so the browser does not hit CORS:
NEXT_PUBLIC_API_URL=/backend
SCILAB_API_ORIGIN=https://scilab-api.epsilon.io.vn
#
# Direct public URL (will fail in browser until CORS is enabled on API):
# NEXT_PUBLIC_API_URL=https://scilab-api.epsilon.io.vn
#
# Local API:
# NEXT_PUBLIC_API_URL=http://localhost:6003
