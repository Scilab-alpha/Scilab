# Backend data source for the web app: `public` | `local`
# - public → https://scilab-api.epsilon.io.vn
# - local  → Docker/local Nest (default http://localhost:6003)
NEXT_PUBLIC_API_DATA_SOURCE=public

# Optional override when NEXT_PUBLIC_API_DATA_SOURCE=local
# NEXT_PUBLIC_LOCAL_API_URL=http://localhost:6003

# Optional server-only override for auth BFF upstream (wins over data source)
# SCILAB_API_ORIGIN=https://scilab-api.epsilon.io.vn
